<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension
         point="org.eclipse.ui.commands">
      <category
            id="org.e1c.edt.semantic.commands.category"
            name="Semantic Endpoint">
      </category>
      <command
            categoryId="org.e1c.edt.semantic.commands.category"
            name="Activate/Deactivate"
            id="org.e1c.edt.semantic.commands.activateCommand">
      </command>
   </extension>
   <extension
         point="org.eclipse.ui.handlers">
      <handler
            class="org.e1c.edt.semantic.ActivateHandler"
            commandId="org.e1c.edt.semantic.commands.activateCommand">
      </handler>
   </extension>
   <extension
         point="org.eclipse.ui.bindings">
      <key
            commandId="org.e1c.edt.semantic.commands.activateCommand"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            contextId="org.eclipse.ui.contexts.window"
            sequence="M1+6">
      </key>
   </extension>
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu
               id="org.e1c.edt.semantic.menus.semanticEndpointMenu"
               label="Semantic Endpoint"
               mnemonic="S">
            <command
                  commandId="org.e1c.edt.semantic.commands.activateCommand"
                  id="org.e1c.edt.semantic.menus.activateCommand"
                  mnemonic="A">
            </command>
         </menu>
      </menuContribution>
   </extension>
   <extension
         point="org.eclipse.ui.startup">
      <startup
            class="org.e1c.edt.semantic.Startup">
      </startup>
   </extension>

</plugin>
