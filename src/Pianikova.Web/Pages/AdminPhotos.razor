@page "/admin/photos"
@inject GitHubAuthState Auth
@inject GitHubApiClient Api
@inject NavigationManager Nav

<PageTitle>Фото · Редактор</PageTitle>
<HeadContent><meta name="robots" content="noindex, nofollow" /></HeadContent>

<main class="admin-shell">
    <div class="admin-header">
        <h1>Фото</h1>
        <a class="admin-back" href="/admin">← Ко всем разделам</a>
    </div>

    @if (_loading)
    {
        <p>Загрузка…</p>
    }
    else
    {
        @if (_error is not null)
        {
            <p class="admin-error">@_error</p>
        }
        @if (_success is not null)
        {
            <p class="admin-success">@_success</p>
        }

        @for (var i = 0; i < _photos.Count; i++)
        {
            var index = i;
            var photo = _photos[index];
            <div class="admin-card">
                <div class="admin-list-item-head">
                    <div>
                        <strong>@(string.IsNullOrWhiteSpace(photo.CaptionEn) ? photo.Id : photo.CaptionEn)</strong>
                    </div>
                    <div class="admin-row-actions">
                        <button type="button" class="button button-quiet" @onclick="() => MoveUp(index)" disabled="@(index == 0)" aria-label="Выше">↑</button>
                        <button type="button" class="button button-quiet" @onclick="() => MoveDown(index)" disabled="@(index == _photos.Count - 1)" aria-label="Ниже">↓</button>
                        <button type="button" class="button" @onclick="() => Toggle(photo)">
                            @(_editing == photo ? "Свернуть" : "Изменить")
                        </button>
                        <button type="button" class="button button-quiet" @onclick="() => Remove(photo)">Удалить</button>
                    </div>
                </div>
                @if (_editing == photo)
                {
                    <PhotoEditor Model="photo" OnClose="() => Toggle(photo)" />
                }
            </div>
        }

        <button type="button" class="button" @onclick="AddPhoto">Добавить фото</button>

        <div class="admin-actions">
            <button class="button button-primary" @onclick="SaveAsync" disabled="@_saving">
                @(_saving ? "Сохраняем…" : "Сохранить всё")
            </button>
        </div>
    }
</main>

@code {
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _success;

    private PhotosDocument? _originalEn;
    private PhotosDocument? _originalRu;
    private readonly List<PhotoEdit> _photos = [];
    private PhotoEdit? _editing;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/admin");
            return;
        }

        try
        {
            _originalEn = await Api.GetFileAsync<PhotosDocument>("content/photos/en/photos.json");
            _originalRu = await Api.GetFileAsync<PhotosDocument>("content/photos/ru/photos.json");

            var ruById = _originalRu.Items.ToDictionary(x => x.Id, StringComparer.OrdinalIgnoreCase);
            foreach (var en in _originalEn.Items)
            {
                var ru = ruById.TryGetValue(en.Id, out var match) ? match : en;
                _photos.Add(PhotoEdit.FromDocuments(en, ru));
            }
        }
        catch (Exception ex)
        {
            _error = $"Не удалось загрузить данные: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Toggle(PhotoEdit photo) => _editing = _editing == photo ? null : photo;

    private void MoveUp(int index)
    {
        if (index <= 0)
        {
            return;
        }

        (_photos[index - 1], _photos[index]) = (_photos[index], _photos[index - 1]);
    }

    private void MoveDown(int index)
    {
        if (index >= _photos.Count - 1)
        {
            return;
        }

        (_photos[index + 1], _photos[index]) = (_photos[index], _photos[index + 1]);
    }

    private void AddPhoto()
    {
        var photo = new PhotoEdit { Id = $"new-photo-{_photos.Count + 1}" };
        _photos.Add(photo);
        _editing = photo;
    }

    private void Remove(PhotoEdit photo)
    {
        _photos.Remove(photo);
        if (_editing == photo)
        {
            _editing = null;
        }
    }

    private async Task SaveAsync()
    {
        if (_originalEn is null || _originalRu is null)
        {
            return;
        }

        if (_photos.Select(x => x.Id.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).Count() != _photos.Count)
        {
            _error = "У двух фото совпадает ID — сделайте идентификаторы уникальными.";
            return;
        }

        if (_photos.Any(x => string.IsNullOrWhiteSpace(x.Path) && x.PendingBytes is null))
        {
            _error = "Для каждого фото нужно выбрать файл.";
            return;
        }

        _error = null;
        _success = null;
        _saving = true;
        try
        {
            foreach (var photo in _photos.Where(x => x.PendingBytes is not null && x.PendingFileName is not null))
            {
                await Api.PutMediaAsync($"content/media/images/{photo.PendingFileName}", photo.PendingBytes!, $"Upload gallery photo {photo.PendingFileName} via admin");
                photo.Path = $"media/images/{photo.PendingFileName}";
                photo.PendingBytes = null;
                photo.PendingFileName = null;
                photo.PendingDataUrl = null;
            }

            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            var updatedEn = _originalEn with { LastUpdated = today, Items = _photos.Select(x => x.ToDocument(english: true)).ToArray() };
            var updatedRu = _originalRu with { LastUpdated = today, Items = _photos.Select(x => x.ToDocument(english: false)).ToArray() };

            await Api.PutJsonAsync("content/photos/en/photos.json", updatedEn, "Update photos (en) via admin");
            await Api.PutJsonAsync("content/photos/ru/photos.json", updatedRu, "Update photos (ru) via admin");

            _originalEn = updatedEn;
            _originalRu = updatedRu;
            _success = "Сохранено.";
        }
        catch (Exception ex)
        {
            _error = $"Не удалось сохранить: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
