@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject IStringLocalizer<Ui> L
@inject ISiteContentSource Content

@if (_posts.Count > 0)
{
    <section id="telegram" class="telegram-feed section-pad numbered-section" aria-label="@L["TelegramFeedTitle"]">
        <header class="section-heading">
            <div>
                <p class="eyebrow">Telegram</p>
                <h2>@L["TelegramFeedTitle"]</h2>
            </div>
            <div class="telegram-feed-links">
                <a class="text-link" href="journal">@L["JournalFullJournal"] <span aria-hidden="true">→</span></a>
                <a class="text-link" href="@ChannelUrl" target="_blank" rel="noopener noreferrer">@L["TelegramChannel"] <span aria-hidden="true">↗</span></a>
            </div>
        </header>
        <div class="telegram-posts">
            @foreach (var post in _posts)
            {
                <article class="telegram-post">
                    <time datetime="@post.Date.ToString("O")">@post.Date.ToString("d MMMM yyyy", CultureInfo.GetCultureInfo(Language))</time>
                    <p>@Excerpt(post.Text)</p>
                    <a class="text-link" href="@post.Url" target="_blank" rel="noopener noreferrer">@L["TelegramReadPost"] <span aria-hidden="true">↗</span></a>
                </article>
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public string FeedUrl { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ChannelUrl { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Language { get; set; } = "ru";

    private readonly CancellationTokenSource _dispose = new();
    private IReadOnlyList<TelegramPost> _dynamicPosts = [];
    private IReadOnlyList<TelegramPost> _staticPosts = [];
    private IReadOnlyList<TelegramPost> _posts = [];
    private Task? _refreshTask;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync(_dispose.Token);
        _refreshTask = RefreshLoopAsync(_dispose.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(5));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (!await JS.InvokeAsync<bool>("pianikovaTelegramFeed.isVisible", cancellationToken)) continue;
                await RefreshAsync(cancellationToken);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private async Task RefreshAsync(CancellationToken cancellationToken)
    {
        using var dynamicTimeout = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
        dynamicTimeout.CancelAfter(TimeSpan.FromSeconds(8));
        try
        {
            var feed = await Http.GetFromJsonAsync<TelegramFeedResponse>(FeedUrl, dynamicTimeout.Token);
            if (feed is not null) _dynamicPosts = feed.Posts ?? [];
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JsonException)
        {
            // Keep the last successful dynamic feed if the endpoint is temporarily unavailable.
        }

        using var staticTimeout = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
        staticTimeout.CancelAfter(TimeSpan.FromSeconds(8));
        try
        {
            var staticUrl = Content.AssetUrl("telegram/posts.json");
            var feed = await Http.GetFromJsonAsync<TelegramStaticFeed>($"{staticUrl}?refresh={DateTimeOffset.UtcNow.ToUnixTimeSeconds()}", staticTimeout.Token);
            if (feed?.SchemaVersion == 1) _staticPosts = feed.Posts?.Where(IsValidStaticPost).ToArray() ?? [];
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JsonException)
        {
            // Keep the last successful static feed if the file is temporarily unavailable.
        }

        var combined = _dynamicPosts.ToDictionary(post => post.Id);
        foreach (var post in _staticPosts)
        {
            if (post.Hidden) combined.Remove(post.Id);
            else combined[post.Id] = post;
        }
        _posts = combined.Values.OrderByDescending(post => post.Date).ThenByDescending(post => post.Id).Take(5).ToArray();
    }

    private static bool IsValidStaticPost(TelegramPost post) =>
        post.Id > 0 &&
        !string.IsNullOrWhiteSpace(post.Text) &&
        Uri.TryCreate(post.Url, UriKind.Absolute, out var telegramUrl) &&
        telegramUrl.Scheme == Uri.UriSchemeHttps &&
        telegramUrl.Host.Equals("t.me", StringComparison.OrdinalIgnoreCase) &&
        telegramUrl.AbsolutePath == $"/gattavasis/{post.Id}" &&
        Uri.TryCreate(post.SiteUrl, UriKind.Absolute, out var siteUrl) &&
        siteUrl.Scheme is "https" or "http" &&
        siteUrl.UserInfo.Length == 0 && siteUrl.IsDefaultPort &&
        (siteUrl.Host.Equals("pianikova.com", StringComparison.OrdinalIgnoreCase) ||
         siteUrl.Host.Equals("www.pianikova.com", StringComparison.OrdinalIgnoreCase));

    private static string Excerpt(string text)
    {
        var normalized = string.Join(' ', text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
        var characters = normalized.EnumerateRunes().ToArray();
        return characters.Length > 360 ? string.Concat(characters.Take(359).Select(rune => rune.ToString())) + "…" : normalized;
    }

    public async ValueTask DisposeAsync()
    {
        await _dispose.CancelAsync();
        if (_refreshTask is not null) await _refreshTask;
        _dispose.Dispose();
    }

    private sealed record TelegramFeedResponse(IReadOnlyList<TelegramPost>? Posts);
    private sealed record TelegramStaticFeed(int SchemaVersion, IReadOnlyList<TelegramPost>? Posts);
    private sealed record TelegramPost(long Id, DateTimeOffset Date, string Text, string Url, string? SiteUrl = null, bool Hidden = false);
}
