<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <PureDiVersion>2.5.2</PureDiVersion>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.12" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Pure.DI" Version="2.5.4" PrivateAssets="all" />
    <PackageReference Include="Pure.DI.MS" Version="2.5.4" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="wwwroot\content\**\*" />
  </ItemGroup>
  <ItemGroup Condition="'$(PianikovaProduction)' != 'true'">
    <LocalContent Include="..\..\content\**\*" />
  </ItemGroup>
  <Target Name="SyncLocalContent"
          BeforeTargets="ResolveProjectStaticWebAssets"
          Condition="'$(PianikovaProduction)' != 'true'">
    <RemoveDir Directories="wwwroot\content" />
    <ItemGroup>
      <LocalContentDestination Include="@(LocalContent->'wwwroot\content\%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(LocalContent)"
          DestinationFiles="@(LocalContentDestination)"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Include="@(LocalContentDestination)" />
    </ItemGroup>
  </Target>
</Project>
