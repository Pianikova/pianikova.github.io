<?xml version="1.0" encoding="UTF-8"?>
<project
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
  xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <artifactId>mirror.eclipse</artifactId>
  <groupId>mirror</groupId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Eclipse Repo mirror</name>

  <properties>
      <tycho-version>2.7.5</tycho-version>
      <destination>${project.build.directory}/repo</destination>
      <eclipse.p2.url>http://npya:Catcat01@artifactory.boreas.dept07/artifactory/p2-release-public/g5/release/codeai/1.0.4/</eclipse.p2.url>
      <p2.name>1C:Warkmate repository</p2.name>
  </properties>

  <build>
    <plugins>
        <plugin>
            <groupId>org.eclipse.tycho.extras</groupId>
            <artifactId>tycho-p2-extras-plugin</artifactId>
            <version>${tycho-version}</version>
            <executions>
                <execution>
                    <phase>prepare-package</phase>
                    <goals>
                        <goal>mirror</goal>
                    </goals>
                </execution>
            </executions>
            <configuration>
		<name>${p2.name}</name>
                <source>
                    <!-- source repositories to mirror from -->
                    <repository>
                        <url>${eclipse.p2.url}</url>
                        <layout>p2</layout>
                        <!-- supported layouts are "p2-metadata", "p2-artifacts", and "p2" (for joint repositories; default) -->
                    </repository>
                </source>

                <!-- starting from here all configuration parameters are optional -->
                <!-- they are only shown here with default values for documentation purpose -->

                <!-- The destination directory to mirror to. -->
                <destination>${destination}</destination>
                <!-- Whether only strict dependencies should be followed. -->
                <!-- "strict" means perfect version match -->
                <followStrictOnly>false</followStrictOnly>
                <!-- Whether or not to follow optional requirements. -->
                <includeOptional>true</includeOptional>
                <!-- Whether or not to follow non-greedy requirements. -->
                <includeNonGreedy>true</includeNonGreedy>
                <!-- Filter properties. E.g. filter only one platform -->
				<!--
                <filter>
                    <osgi.os>linux</osgi.os>
                    <osgi.ws>gtk</osgi.ws>
                    <osgi.arch>x86_64</osgi.arch>
                </filter>
				-->
                <!-- include the latest version of each IU -->
                <latestVersionOnly>true</latestVersionOnly>
                <!-- don't mirror artifacts, only metadata -->
                <mirrorMetadataOnly>false</mirrorMetadataOnly>
                <!-- whether to compress the content.xml/artifacts.xml -->
                <compress>true</compress>
                <!-- whether to append to the target repository content -->
                <append>true</append>
                <!-- whether to mirror pack200 artifacts also. Available since tycho-extras 0.17.0 -->
                <includePacked>true</includePacked>
            </configuration>
        </plugin>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
                <execution>
                    <id>package-mirror-zip</id>
                    <phase>package</phase>
                    <goals>
                        <goal>run</goal>
                    </goals>
                    <configuration>
                        <target>
                            <fileset id="aijar.fs" dir="${destination}/plugins" includes="com.e1c.edt.ai_*.jar"/>
                            <pathconvert property="aijar.path" refid="aijar.fs"/>
                            <basename property="aijar.name" file="${aijar.path}" suffix=".jar"/>
                            <loadresource property="zip.version">
                                <propertyresource name="aijar.name"/>
                                <filterchain>
                                    <tokenfilter>
                                        <replaceregex pattern="^com\.e1c\.edt\.ai_" replace=""/>
                                    </tokenfilter>
                                </filterchain>
                            </loadresource>
                            <echo message="Mirrored version: ${zip.version}"/>
                            <echo file="${destination}/p2.index">version=1
metadata.repository.factory.order=content.xml,!
artifact.repository.factory.order=artifacts.xml,!
</echo>
                            <zip destfile="${project.build.directory}/com.e1c.edt.ai.repository-${zip.version}.zip" basedir="${destination}"/>
                        </target>
                    </configuration>
                </execution>
            </executions>
        </plugin>
    </plugins>
  </build>

</project>
